# Copie para k8s/secrets.env (ignorado pelo Git) e defina valores próprios.
# Usado pelo secretGenerator do kustomization.yaml para criar o Secret garagehub-secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura dos tokens JWT (mínimo de 32 caracteres)
JWT_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
