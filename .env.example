# Copie este arquivo para .env e ajuste os valores.
# O .env é ignorado pelo Git. Sem ele, o docker-compose usa os valores
# padrão de desenvolvimento definidos no próprio docker-compose.yml.

POSTGRES_DB=garagehub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura dos tokens JWT (mínimo de 32 caracteres)
JWT_KEY=troque-por-uma-chave-aleatoria-com-32-ou-mais-caracteres
